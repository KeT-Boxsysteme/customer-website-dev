<%- include('../partials/head', { title: 'Diagrams: ' + box.box_alias }) %>
<body class="app-layout">
  <%- include('../partials/nav', { currentPage: 'diagrams' }) %>

  <main class="main-content">
    <div class="page-header">
      <h1 class="page-brand"><span class="brand-main"><%- include('../partials/brand') %></span></h1>
    </div>

    <%- include('../partials/flash') %>

    <div class="detail-column">
    <div class="section-head">
      <div>
        <h2 class="section-title">
          <%= box.box_alias %> <span class="mono text-muted">&nbsp;#<%= box.project_number %></span>
        </h2>
        <p class="section-desc">All values of this box in one chart — <%= range.label %>. Updates itself every 30 s.</p>
      </div>
    </div>

    <!-- Time range: short ranges for the sensor, long ones as in the Konzept (6/9/12 months) -->
    <nav class="range-tabs" aria-label="Time range">
      <% ranges.forEach(r => { %>
      <a href="/diagrams/<%= box.id %>?range=<%= r.key %>" class="range-tab<%= r.key === range.key ? ' is-active' : '' %>"<%- r.key === range.key ? ' aria-current="page"' : '' %>><%= r.label %></a>
      <% }) %>
    </nav>

    <!-- EIN Diagramm mit allen Werten (Betreiber 02.10.): ppm links, °C rechts; live alle 30 s (Betreiber 28.10.) -->
    <section class="chart-card">
      <div class="chart-card__head">
        <h3 class="chart-card__title">All values</h3>
        <p class="chart-card__meta"><% if (charts.ppm) { %>O₂ / H₂O: yellow from 5 ppm · red from 10 ppm<% } %><% if (charts.ppm && charts.temp && charts.temp.target !== null) { %> · <% } %><% if (charts.temp && charts.temp.target !== null) { %>Fridge: target <%= charts.temp.target %> °C · yellow from ±<%= charts.temp.limits.yellow %> °C · red from ±<%= charts.temp.limits.red %> °C<% } %><% if (charts.boxTemp) { %> · Box temperature: information only<% } %></p>
      </div>
      <% if (charts.temp && charts.temp.stats) { const st = charts.temp.stats; %>
      <dl class="kpi-row">
        <div class="kpi"><dt>Fridge latest</dt><dd><%= st.last.toFixed(1) %> °C</dd></div>
        <div class="kpi"><dt>Min</dt><dd><%= st.min.toFixed(1) %> °C</dd></div>
        <div class="kpi"><dt>Max</dt><dd><%= st.max.toFixed(1) %> °C</dd></div>
        <div class="kpi<%= st.outsidePct > 0 ? ' kpi--warn' : '' %>"><dt>Outside ±<%= charts.temp.limits.yellow %> °C</dt><dd><%= st.outsidePct %> %</dd></div>
      </dl>
      <% } %>
      <% if (charts.hasAny) { %>
      <div class="chart-card__canvas chart-card__canvas--tall"><canvas id="mainChart" data-live-url="/diagrams/<%= box.id %>/data?range=<%= range.key %>"></canvas></div>
      <p class="chart-card__note">Average per <%= range.bucketMinutes < 60 ? range.bucketMinutes + ' min' : (range.bucketMinutes / 60) + ' h' %><% if (charts.temp) { %>, fridge with min–max band<% } %>. Hollow dots: live value now. <span data-chart-updated></span></p>
      <% } else { %>
      <p class="empty-state empty-state--plain">No values in this period.</p>
      <% } %>
    </section>

    <!-- Manual entries (Werteeingabe im Monitoring) -->
    <h3 class="chart-card__title">Manual entries</h3>
    <div class="table-scroll">
      <table class="data-table data-table--cards">
        <thead>
          <tr>
            <th>Date</th>
            <th>User</th>
            <% if (box.has_o2_sensor) { %><th>O₂ (ppm)</th><% } %>
            <% if (box.has_h2o_sensor) { %><th>H₂O (ppm)</th><% } %>
            <% if (box.has_fridge) { %><th>Fridge (°C)</th><% } %>
            <% if (box.has_pressure_sensor) { %><th>Pressure (bar)</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (measurements.length === 0) { %>
          <tr><td colspan="6" class="empty-cell">No data available for this period.</td></tr>
          <% } else { %>
          <% measurements.forEach(m => { %>
          <tr>
            <td data-label="Date"><%= new Date(m.measured_at).toLocaleString('en-GB') %></td>
            <td data-label="User" class="mono"><%= m.username || '-' %></td>
            <% if (box.has_o2_sensor) { %><td data-label="O₂ (ppm)"><%= m.o2_value !== null ? m.o2_value : '-' %></td><% } %>
            <% if (box.has_h2o_sensor) { %><td data-label="H₂O (ppm)"><%= m.h2o_value !== null ? m.h2o_value : '-' %></td><% } %>
            <% if (box.has_fridge) { %><td data-label="Fridge (°C)"><%= m.fridge_temp !== null ? m.fridge_temp : '-' %></td><% } %>
            <% if (box.has_pressure_sensor) { %><td data-label="Pressure (bar)"><%= m.pressure_value !== null ? m.pressure_value : '-' %></td><% } %>
          </tr>
          <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    </div><!-- /.detail-column -->
  </main>

  <script src="<%= asset('/js/vendor/chart.umd.min.js') %>"></script>
  <script type="application/json" id="chartData"><%- chartsJson %></script>
  <script src="<%= asset('/js/diagram-chart.js') %>"></script>
<%- include('../partials/footer') %>
